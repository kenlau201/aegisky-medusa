# ============================================================
# Aegisky Medusa - Production Environment Variables
# Copy to .env.production and fill in real values
# ============================================================

# Application
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://aegisky.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://medusa:STRONG_PASSWORD@localhost:5434/medusa-aegisky

# Redis
REDIS_URL=redis://:STRONG_REDIS_PASSWORD@localhost:6380

# Medusa
MEDUSA_ADMIN_ONBOARDING_EMAIL=admin@aegisky.com
MEDUSA_ADMIN_ONBOARDING_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Stripe (Production keys from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_KEY=pk_live_XXXXXXXXXXXXX

# EasyPost (Production key from https://easypost.com)
EASYPOST_API_KEY=ezip_XXXXXXXXXXXXX

# Cloudflare R2 (Image storage - no egress fees)
R2_ACCOUNT_ID=XXXXXXXXXXXXX
R2_ACCESS_KEY_ID=XXXXXXXXXXXXX
R2_SECRET_ACCESS_KEY=XXXXXXXXXXXXX
R2_BUCKET_NAME=aegisky-media
R2_PUBLIC_URL=https://media.aegisky.com

# Sentry (Error monitoring - https://sentry.io)
SENTRY_DSN=https://XXXXXXXXXXXXX@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=https://XXXXXXXXXXXXX@o0.ingest.sentry.io/0

# Email SMTP (Transactional emails)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.XXXXXXXXXXXXX
SMTP_FROM=orders@aegisky.com
SMTP_FROM_NAME=Aegisky Orders

# Security
JWT_SECRET=GENERATE_STRONG_RANDOM_STRING_64_CHARS
COOKIE_SECRET=GENERATE_ANOTHER_STRONG_RANDOM_STRING

# Publishable API Key (auto-generated, set after running create-api-key script)
NEXT_PUBLIC_PUBLISHABLE_KEY=pk_XXXXXXXXXXXXX
