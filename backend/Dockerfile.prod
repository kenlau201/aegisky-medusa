# ============================================
# Aegisky Medusa Backend - Production Dockerfile
# ============================================
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
RUN npm ci --legacy-peer-deps

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build Medusa
RUN npx medusa build

# Production image, copy all the files and run medusa
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV MEDUSA_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 medusa

# Copy built application
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/medusa-config.ts ./medusa-config.ts
COPY --from=builder /app/tsconfig.json ./tsconfig.json

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs
RUN chown -R medusa:nodejs /app

USER medusa

EXPOSE 9000

ENV PORT=9000
ENV HOST=0.0.0.0

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:9000/store/health || exit 1

CMD ["npx", "medusa", "start", "--port", "9000", "--host", "0.0.0.0"]
